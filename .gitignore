# 依赖与构建产物
node_modules/
dist/
# build/ 含打包图标（源资产，入库）；其余打包中间物忽略
build/*
!build/icon.icns
!build/icon.png
!build/icon-1024.png
!build/entitlements.mac.plist
!build/notarize.js

# agent 测试时误落根目录的产物副本（正身在 public/ 与 public/vendor/）
/app.js
/milkdown.js

# 系统与编辑器
.DS_Store
*.log
.idea/
.vscode/

# 本地运行时（翻箱的收藏/最近记录存在用户主目录，不入库）
.fanbox/

# MCP 配置（含 API key，不入库）
.mcp.json

# Sandcastle：编排源码入库；密钥/日志/worktree 由 .sandcastle/.gitignore 排除
# （新 worktree 必须能检出 .sandcastle/setup-mcp.js，否则 copyToWorktree 复制失败）
/plan.json

